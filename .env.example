# Copy this file to .env and adjust the values. Never commit .env.

# Postgres from docker-compose.yml (host port 5433 -> container port 5432).
DATABASE_URL=postgresql+psycopg://documind:documind@127.0.0.1:5433/documind

# Database used only by the test suite; created automatically on the first test run.
TEST_DATABASE_URL=postgresql+psycopg://documind:documind@127.0.0.1:5433/documind_test

# Seconds to wait for each database connection attempt before giving up.
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
